# Environment
ENVIRONMENT=development
TESTING=false
API_V1_STR=/api/v1

# Security
# Run: openssl rand -hex 32
JWT_SECRET_KEY=placeholder_jwt_secret_key_change_me_in_production
JWT_REFRESH_SECRET_KEY=placeholder_jwt_refresh_secret_key_change_me_in_production
# Required in production: v2:<new_64_hex_characters>,v1:<previous_64_hex_characters>
OUTBOX_ENCRYPTION_KEYS=
PASSWORD_BCRYPT_ROUNDS=12
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
AUTH_LOGIN_RATE_LIMIT=30
AUTH_LOGIN_RATE_WINDOW_SECONDS=60
AUTH_LOGIN_LOCKOUT_LIMIT=5
AUTH_LOGIN_LOCKOUT_WINDOW_SECONDS=900
AUTH_LOGIN_AGGREGATE_LIMIT=300
AUTH_LOGIN_AGGREGATE_WINDOW_SECONDS=60
AUTH_RESEND_COOLDOWN_SECONDS=60
AUTH_RESEND_ACCOUNT_LIMIT=5
AUTH_RESEND_ACCOUNT_WINDOW_SECONDS=3600
AUTH_RESEND_CLIENT_LIMIT=10
AUTH_RESEND_CLIENT_WINDOW_SECONDS=3600
AUTH_RESEND_AGGREGATE_LIMIT=50
AUTH_RESEND_AGGREGATE_WINDOW_SECONDS=3600
AUTH_VERIFY_RATE_LIMIT=30
AUTH_VERIFY_RATE_WINDOW_SECONDS=60
AUTH_VERIFY_LOCKOUT_LIMIT=5
AUTH_VERIFY_LOCKOUT_WINDOW_SECONDS=900
AUTH_VERIFY_AGGREGATE_LIMIT=300
AUTH_VERIFY_AGGREGATE_WINDOW_SECONDS=60
AUTH_RESET_REQUEST_LIMIT=3
AUTH_RESET_REQUEST_WINDOW_SECONDS=3600
AUTH_RESET_CLIENT_LIMIT=10
AUTH_RESET_CLIENT_WINDOW_SECONDS=3600
AUTH_RESET_AGGREGATE_LIMIT=100
AUTH_RESET_AGGREGATE_WINDOW_SECONDS=3600
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_BOT_SECRET_TOKEN=your_telegram_webhook_secret_token
TELEGRAM_WEBHOOK_URL=https://crm.example.com/api/v1/telegram/webhook

# Database
DATABASE_URL=postgresql+asyncpg://postgres:your_secure_password@localhost:5432/imkon_db

# Redis
REDIS_URL=rediss://imkon_app:replace_with_64_hex_characters@127.0.0.1:6379/0?ssl_ca_certs=/var/lib/imkon/redis_tls/ca.crt&ssl_cert_reqs=required&ssl_check_hostname=true

# SMTP / Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASSWORD=password
SMTP_FROM_EMAIL=noreply@example.com

# SMS (Payomchi)
SMS_API_KEY=
SMS_BASE_URL=https://api.payomchi.tj/api/v1
SMS_SENDER_ID=KitobCRM
SMS_PASSWORD_PENDING_TTL_SECONDS=600
SMS_PASSWORD_GLOBAL_DAILY_LIMIT=1000
SMS_PASSWORD_PHONE_DAILY_LIMIT=10
SMS_PASSWORD_IP_LIMIT=100

# Timezone (Asia/Dushanbe, UTC+5)
TIMEZONE=Asia/Dushanbe

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://localhost:8000", "https://crm-tojiki.instatunnel.my", "https://crm-tojiki.instatunnel.my/", "*"]


DB_CONNECTION_BUDGET=100
DB_API_PROCESSES=1
DB_WORKER_PROCESSES=1
DB_REVISION_OVERLAP=2
DB_ADMIN_RESERVE=10
DB_MAINTENANCE_CONNECTIONS=2
DB_POOL_SIZE=8
DB_MAX_OVERFLOW=2
DB_POOL_TIMEOUT_SECONDS=5
DB_OUTBOX_POOL_SIZE=2
DB_OUTBOX_MAX_OVERFLOW=0
DB_STATEMENT_TIMEOUT_MS=15000
DB_LOCK_TIMEOUT_MS=2000
DB_IDLE_TRANSACTION_TIMEOUT_MS=15000
DB_MAINTENANCE_STATEMENT_TIMEOUT_MS=300000
DB_MAINTENANCE_LOCK_TIMEOUT_MS=10000
DB_MAINTENANCE_IDLE_TRANSACTION_TIMEOUT_MS=300000
